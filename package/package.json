{
  "name": "handicon",
  "version": "0.1.0",
  "description": "Soft, rounded icons for React. 56 icons on a 24px grid, with size, stroke and color as props.",
  "keywords": ["icons", "react", "svg", "icon-library", "nextjs", "handicon"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "svg", "README.md", "LICENSE"],
  "peerDependencies": {
    "react": ">=17"
  }
}
